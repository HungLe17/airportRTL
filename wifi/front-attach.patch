+namespace {
+// Radio workers borrow the callback table only while front teardown is
+// waiting for admitted calls. Never hold the admission lock across a callback.
+class FrontCallback {
+public:
+    FrontCallback(IOLock *lock, struct owly_abi6_rx_gate &gate) : lock(lock), gate(gate)
+    {
+        if (!lock)
+            return;
+        IOLockLock(lock);
+        admitted = owly_abi6_gate_enter(&gate);
+        IOLockUnlock(lock);
+    }
+
+    ~FrontCallback()
+    {
+        if (!admitted)
+            return;
+        IOLockLock(lock);
+        owly_abi6_gate_leave(&gate);
+        IOLockUnlock(lock);
+    }
+
+    explicit operator bool() const { return admitted; }
+    FrontCallback(const FrontCallback &) = delete;
+    FrontCallback &operator=(const FrontCallback &) = delete;
+
+private:
+    IOLock *lock;
+    struct owly_abi6_rx_gate &gate;
+    bool admitted = false;
+};
+}
